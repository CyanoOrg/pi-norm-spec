{
  "name": "@cyanoorg/pi-norm-spec",
  "version": "0.1.0-alpha.1",
  "description": "Rust-backed pi adapter for norm-spec conventions",
  "license": "MIT",
  "author": "Wade <bravetwo@163.com>",
  "repository": "https://github.com/CyanoOrg/pi-norm-spec",
  "keywords": ["pi-package", "norm-spec"],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": ["bin", "extensions", "runtime", "skills", "release.json"],
  "bin": {
    "pi-norm-spec": "bin/pi-norm-spec.js"
  },
  "pi": {
    "extensions": ["./extensions/norm-context.ts"]
  },
  "normSpec": {
    "productCompat": "=0.1.0-rc.1",
    "formatCompat": ["norm-spec/a1"],
    "compatibilityApi": "norm-spec/compatibility/v1",
    "collectApi": "norm-spec/collect/v1",
    "validateApi": "norm-spec/validate/v1",
    "contractBundleApi": "norm-spec/contract-bundle/v1",
    "conformanceApi": "norm-spec/conformance/v1",
    "conformanceSuite": "norm-spec/a1-cli/v1",
    "conformanceCaseCount": 82,
    "contractDigest": "sha256:3d94441e9cde3ef9489618bdb8fbf37f6979331bea099acadf0136b65df7e2eb",
    "bridgeApi": "pi-norm-spec/bridge/v1",
    "promptContextApi": "pi-norm-spec/prompt-context/v1",
    "platformRuntimeApi": "pi-norm-spec/platform-runtime/v1",
    "packageReleaseApi": "pi-norm-spec/package-release/v1",
    "packageRuntimeApi": "pi-norm-spec/package-runtime/v1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "optionalDependencies": {
    "@cyanoorg/pi-norm-spec-linux-x64": "0.1.0-alpha.1",
    "@cyanoorg/pi-norm-spec-darwin-arm64": "0.1.0-alpha.1",
    "@cyanoorg/pi-norm-spec-darwin-x64": "0.1.0-alpha.1",
    "@cyanoorg/pi-norm-spec-win32-x64": "0.1.0-alpha.1"
  }
}
