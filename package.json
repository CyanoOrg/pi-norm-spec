{
  "name": "pi-norm-spec",
  "version": "0.2.0-alpha.1",
  "description": "Rust-backed pi adapter for norm-spec conventions",
  "license": "MIT",
  "author": "Wade",
  "keywords": ["pi-package", "norm-spec"],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck"
  },
  "pi": {
    "extensions": ["./extensions"]
  },
  "normSpec": {
    "productCompat": ">=0.4.0-alpha.1 <0.5.0",
    "collectApi": "norm-spec/collect/v1",
    "bridgeApi": "pi-norm-spec/bridge/v1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typescript": "7.0.2"
  }
}
