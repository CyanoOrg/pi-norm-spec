{
  "name": "pi-norm-spec",
  "version": "0.1.0-alpha.1",
  "description": "Rust-backed pi adapter for norm-spec conventions",
  "license": "MIT",
  "author": "Wade",
  "keywords": ["pi-package", "norm-spec"],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/extension/*.test.ts"
  },
  "pi": {
    "extensions": ["./extensions"]
  },
  "normSpec": {
    "productCompat": "=0.1.0-rc.1",
    "formatCompat": ["norm-spec/a1"],
    "compatibilityApi": "norm-spec/compatibility/v1",
    "collectApi": "norm-spec/collect/v1",
    "validateApi": "norm-spec/validate/v1",
    "contractBundleApi": "norm-spec/contract-bundle/v1",
    "conformanceApi": "norm-spec/conformance/v1",
    "conformanceSuite": "norm-spec/a1-cli/v1",
    "conformanceCaseCount": 82,
    "contractDigest": "sha256:3d94441e9cde3ef9489618bdb8fbf37f6979331bea099acadf0136b65df7e2eb",
    "bridgeApi": "pi-norm-spec/bridge/v1",
    "platformRuntimeApi": "pi-norm-spec/platform-runtime/v1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typescript": "7.0.2"
  }
}
