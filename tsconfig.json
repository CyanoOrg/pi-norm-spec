{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "bin/**/*.js",
    "extensions/**/*.ts",
    "runtime/**/*.js",
    "scripts/**/*.ts",
    "tests/extension/**/*.ts"
  ]
}
